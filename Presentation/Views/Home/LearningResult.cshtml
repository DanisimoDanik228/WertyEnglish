@model long

<div class="bg-black text-light d-flex flex-column justify-content-between p-3"
     style="height: 100dvh;">
    <div>
        <a href="/" class="btn btn-outline-secondary" title="Back Home">
            <i class="bi bi-house-door fs-5"></i>
        </a>
        <a href="/Home/Dictionary?id=@Model" class="btn btn-outline-secondary" title="Back Dictionary">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
    </div>

    <div class="d-flex justify-content-center">
        <div class="border border-2 rounded-2 col-10 col-sm-4 shadow-light p-2 position-relative">
            <div id="result" class="text-center">

            </div>
        </div>
    </div>

    <div>
        <a href="/Home/Learning?Id=@Model" class="btn btn-outline-secondary">
            Continue
        </a>
    </div>
</div>

<script>
	const unknownWords = JSON.parse(localStorage.getItem("unknownWords"));
	const countAllWords = JSON.parse(localStorage.getItem("countAllWords"));

    document.getElementById('result').innerText = `${unknownWords.length}/${countAllWords}`;
</script>